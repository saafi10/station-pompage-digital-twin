    {
        "id": "aa0a3782436fc6b6",
        "type": "function",
        "z": "9b7b90585f079963",
        "name": "🔧 SQL INSERT",
        "func": "const d = msg.payload;\n\n// Construction de la requête SQL\nconst sql = `INSERT INTO pump_data (time, pump_id, pressure, flow_rate, temperature, vibration, power_consumption, status)\nVALUES (NOW(), 1, ${d.pumps?.a?.pressure || 0}, ${d.pumps?.a?.flow || 0}, ${d.pumps?.a?.temperature || 0}, ${d.pumps?.a?.vibration || 0}, ${(d.pumps?.a?.current || 0) * 400}, 'RUNNING')`;\n\nmsg.params = [\n    1,\n    d.pumps?.a?.pressure || 0,\n    d.pumps?.a?.flow || 0,\n    d.pumps?.a?.temperature || 0,\n    d.pumps?.a?.vibration || 0,\n    (d.pumps?.a?.current || 0) * 400,\n    d.pumps?.a?.status ? 'RUNNING' : 'STOPPED',\n    d.tank?.level || 0,\n    d.filter?.clogging || 0,\n    d.heat_exchanger?.sea_water_out || 0,\n    d.heat_exchanger?.delta_t || 0,\n    d.performance?.efficiency || 0,\n    d.performance?.energy_consumption || 0\n];\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 300,
        "y": 100,
        "wires": [
            [
                "fef0d6884100ac98"
            ]
        ]
    },
