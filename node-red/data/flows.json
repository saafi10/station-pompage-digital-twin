    {
        "id": "o-func2",
        "type": "function",
        "z": "tabOpcua",
        "name": "Agreger JSON",
        "func": "if (!context.buffer) context.buffer = {};\ncontext.buffer[msg.topic] = msg.payload;\n\nconst required = ['ns=2;s=pump_a_flow', 'ns=2;s=pump_a_temperature', 'ns=2;s=tank_level', 'ns=2;s=filter_clogging'];\nconst ready = required.every(k => context.buffer[k] !== undefined);\nif (!ready) return null;\n\nconst b = context.buffer;\nmsg.payload = {\n    timestamp: Date.now() / 1000,\n    pumps: {\n        active: 1,\n        a: {\n            flow: b['ns=2;s=pump_a_flow'],\n            pressure: b['ns=2;s=pump_a_pressure'],\n            temperature: b['ns=2;s=pump_a_temperature'],\n            vibration: b['ns=2;s=pump_a_vibration'],\n            current: b['ns=2;s=pump_a_current'],\n            status: b['ns=2;s=pump_a_flow'] > 0,\n            efficiency: b['ns=2;s=pump_a_efficiency'],\n            power: b['ns=2;s=pump_a_power']\n        }\n    },\n    filter: {\n        flow: b['ns=2;s=filter_flow_rate'],\n        clogging: b['ns=2;s=filter_clogging'],\n        pressure_drop: b['ns=2;s=filter_pressure_drop']\n    },\n    tank: { level: b['ns=2;s=tank_level'] },\n    performance: {\n        efficiency: b['ns=2;s=system_efficiency'],\n        energy_consumption: b['ns=2;s=energy_consumption']\n    }\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "x": 850,
        "y": 100,
        "wires": [
            [
                "o-mqttout",
                "o-debug"
            ]
        ]
    },
