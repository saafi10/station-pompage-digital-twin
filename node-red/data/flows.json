        "type": "function",
        "z": "tabOpcua",
        "name": "Construire topics",
        "func": "const nodeIds = [\n    'ns=2;s=pump_a_flow',\n    'ns=2;s=pump_a_pressure',\n    'ns=2;s=pump_a_temperature',\n    'ns=2;s=pump_a_vibration',\n    'ns=2;s=pump_a_current',\n    'ns=2;s=pump_a_efficiency',\n    'ns=2;s=pump_a_power',\n    'ns=2;s=filter_flow_rate',\n    'ns=2;s=filter_clogging',\n    'ns=2;s=filter_pressure_drop',\n    'ns=2;s=tank_level',\n    'ns=2;s=system_efficiency',\n    'ns=2;s=energy_consumption'\n];\nreturn [nodeIds.map(id => ({ topic: id }))];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "x": 380,
        "y": 100,
