    {
        "id": "a-func",
        "type": "function",
        "z": "tabAlertes",
        "name": "Evaluer seuils",
        "func": "const d = msg.payload;\nconst p = d.pumps?.a || {};\nconst f = d.filter || {};\nconst t = d.tank || {};\n\nlet alerts = [];\nif (p.temperature >= 35) alerts.push({type:\"OVERHEAT\", severity:\"CRITICAL\", message:\"Pompe A surchauffe\", value:p.temperature, threshold:35});\nif (p.vibration >= 3) alerts.push({type:\"HIGH_VIBRATION\", severity:\"WARNING\", message:\"Pompe A vibration elevee\", value:p.vibration, threshold:3});\nif (p.current >= 80) alerts.push({type:\"HIGH_CURRENT\", severity:\"WARNING\", message:\"Pompe A courant eleve\", value:p.current, threshold:80});\nif (f.clogging >= 90) alerts.push({type:\"FILTER_CLOGGING\", severity:\"CRITICAL\", message:\"Filtre colmate\", value:f.clogging, threshold:90});\nif (t.level <= 0.5) alerts.push({type:\"LOW_TANK_LEVEL\", severity:\"CRITICAL\", message:\"Niveau bache bas\", value:t.level, threshold:0.5});\n\nif (alerts.length === 0) return null;\nreturn [alerts.map(a => ({ payload: a, params: [a.type, a.severity, a.message, a.value, a.threshold] }))];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "x": 400,
        "y": 100,
        "wires": [
            [
                "a-pg"
            ]
        ]
    },
