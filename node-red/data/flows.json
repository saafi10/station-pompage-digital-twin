    {
        "id": "s-func",
        "type": "function",
        "z": "tabStockage",
        "name": "Parser DB",
        "func": "const d = msg.payload;\nconst p = d.pumps?.a || {};\nconst f = d.filter || {};\nconst t = d.tank || {};\nconst perf = d.performance || {};\n\nmsg.params = [\n    d.timestamp ?? null,\n    d.pumps?.active ?? 0,\n    p.flow ?? null,\n    p.pressure ?? null,\n    p.temperature ?? null,\n    p.vibration ?? null,\n    p.current ?? null,\n    p.status ?? false,\n    p.efficiency ?? null,\n    p.power ?? null,\n    f.flow ?? null,\n    f.clogging ?? null,\n    f.pressure_drop ?? null,\n    t.level ?? null,\n    perf.efficiency ?? null,\n    perf.energy_consumption ?? null\n];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "x": 380,
        "y": 100,
        "wires": [
            [
                "s-pg"
            ]
        ]
    },
